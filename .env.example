# ===== 数据库连接（生产：Supabase PostgreSQL；本地留空则自动使用 SQLite）=====
# 示例占位，请替换为你的 Supabase 连接串（不要提交真实密码到仓库）
# 格式：postgresql://postgres.<project-ref>:<PASSWORD>@<host>:<port>/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ===== 会话安全 =====
# 生产环境请替换为足够长的随机字符串
SECRET_KEY=please-change-this-to-a-long-random-string

# ===== 默认管理员（首次启动自动创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000